CASTUO_GATEWAY_DIR=/opt/castuo-edge
CASTUO_DATA_DIR=/opt/castuo-edge/data
CASTUO_DB_PATH=/opt/castuo-edge/data/buffer.db
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=castuo
MQTT_PASSWORD=
MQTT_CLIENT_ID=castuo-mqtt-gateway
MQTT_TOPIC_SUB=castuo/+/sensors
MQTT_TOPIC_STATUS=castuo/gateway/status
MQTT_KEEPALIVE=30
BACKEND_URL=https://api.castuo-system.es
API_KEY=
DEVICE_ID=RPI-GW-001
POLL_INTERVAL=30
SYNC_BATCH=100
