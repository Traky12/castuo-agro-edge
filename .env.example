# CASTUO Agro Edge — environment template (never commit .env)

# Gateway API
EDGE_HOST=0.0.0.0
EDGE_PORT=8080
EDGE_LOG_LEVEL=INFO

# MQTT (local broker)
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=castuo/edge
# MQTT_USER=
# MQTT_PASSWORD=

# Buffer (SQLite path or Timescale DSN)
BUFFER_BACKEND=sqlite
BUFFER_SQLITE_PATH=/data/edge_buffer.db
# BUFFER_TIMESCALE_URL=postgresql://edge:edge@timescale:5432/edge

# Sync upstream (CASTÚO-SYSTEM core)
CASTUO_API_URL=https://api.example.castuo.local
CASTUO_API_KEY=
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_SECONDS=60

# Edge AI (optional — Mistral EU)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Site identity
SITE_ID=greenhouse-01
TENANT_ID=default
